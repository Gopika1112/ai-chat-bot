{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "server/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "server/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "client/assets/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "client/favicon.ico"
    },
    {
      "source": "/vite.svg",
      "destination": "client/vite.svg"
    },
    {
      "source": "/(.*)",
      "destination": "client/index.html"
    }
  ],
  "env": {
    "NODE_TLS_REJECT_UNAUTHORIZED": "0"
  }
}
